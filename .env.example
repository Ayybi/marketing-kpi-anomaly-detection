# --- KPI / Health Score engine (MongoDB build) ---
# Persistence layer is MongoDB (this build swaps out Supabase/Postgres from the spec).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kpi_engine

# Cron guard (B2). Both crons fail closed without this.
CRON_SECRET=dev-cron-secret-change-me

# Cron cadence. vercel.json ships daily schedules so the repo deploys on Vercel Hobby,
# which permits one run per day. On Pro, set vercel.json back to `15,45 * * * *` and
# leave these unset (defaults: 30 and 1440). These only tune the System Health staleness
# thresholds + the sidebar label — they do not schedule anything themselves.
KPI_ENGINE_INTERVAL_MINUTES=1440
NEXT_PUBLIC_CRON_SCHEDULE_LABEL=0 2 * * *
